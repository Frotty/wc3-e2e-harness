package CanaryAdapter
import E2E
import ClosureTimers
import EvalOrderProbe
import HashMap
import StdlibIngameTests
import UnitIndexBench
import CollectionsBench
import GroupBench

/*  Canary suites (plan: "Native canary suites"). This repository's own map is
	the canary: it exercises every runtime state against the real game without
	any project fixtures. Suites:

	  canary-pass   READY -> RUNNING -> heartbeats -> PASS
	  canary-fail   deliberate assertion failure -> FAIL
	  canary-stall  heartbeats stop without a terminal result
	canary-delay  result only after a longer runtime
	canary-empty  immediate terminal result for a no-op suite
	stdlib-ingame the standard library's own in-game suite, one assert per check
	bench-unit-index   per-unit index stores timed against each other
	bench-collections  ArrayList and LinkedList timed against a bare array
	bench-groups       the ways of iterating a unit group

	The bench suites write Preload marker files around every block; read the
	timings with node/canary/read-bench-markers.cjs after the run.
*/

init
	E2E.register("canary-pass") ->
		E2E.assertTrue("boots", true)
		E2E.recordEvent("canary-event")
		E2E.recordEvent("canary-event")
		doAfter(5.) ->
			E2E.assertTrue("waited", true)
			E2E.finish()

	E2E.register("canary-fail") ->
		E2E.assertTrue("boots", true)
		doAfter(3.) ->
			E2E.assertTrue("deliberate-failure", false)
			E2E.finish()

	E2E.register("canary-stall") ->
		E2E.assertTrue("boots", true)
		doAfter(4.) ->
			E2E.stopHeartbeats()

	E2E.register("canary-delay") ->
		E2E.assertTrue("boots", true)
		doAfter(20.) ->
			E2E.finish()

	E2E.register("canary-empty") ->
		E2E.finish()

	E2E.register("canary-eval-order") ->
		runEvalOrderProbe()

	E2E.register("canary-hashmap-high-real") ->
		let values = new HashMap<int, real>
		let expected = REAL_MAX / 2.
		values.put(1, expected)
		let actual = values.get(1)
		print("HashMap high real expected: " + expected)
		print("HashMap high real actual: " + actual)
		E2E.assertTrue("HashMap preserves a high real", actual == expected)
		destroy values
		// Let at least one heartbeat go out before finishing, as canary-eval-order does: the canary runner
		// passes a normal suite only with heartbeats >= 1, and finishing in the RUNNING callback stops the
		// heartbeat timer before its first tick, so a correct round trip would report CANARY FAIL.
		doAfter(3.) ->
			E2E.finish()

	E2E.register("stdlib-ingame") ->
		runStdlibIngameTests() (checksRun, checksFailed) ->
			let report = stdlibIngameReport()
			for i = 0 to report.size() - 1
				let line = report.get(i)
				if line.contains("FAIL|r") or line.contains("CRASH|r")
					E2E.assertTrue(line, false)
			E2E.assertTrue("stdlib-ingame-all-checks", checksFailed == 0)
			E2E.recordMetric("checksRun", checksRun.toReal())
			E2E.recordMetric("checksFailed", checksFailed.toReal())
			// Let a heartbeat out first; the canary runner wants at least one before a verdict.
			doAfter(3.) ->
				E2E.finish()

	E2E.register("bench-unit-index") ->
		// The bench blocks the game thread for seconds, so it starts only once the
		// RUNNING state and a heartbeat are out; the runner requires both.
		doAfter(2.5) ->
			runUnitIndexBench()
			doAfter(3.) ->
				E2E.finish()

	E2E.register("bench-groups") ->
		doAfter(2.5) ->
			runGroupBench()
			doAfter(3.) ->
				E2E.finish()

	E2E.register("bench-collections") ->
		// The bench blocks the game thread for seconds, so it starts only once the
		// RUNNING state and a heartbeat are out; the runner requires both.
		doAfter(2.5) ->
			runCollectionsBench()
			doAfter(3.) ->
				E2E.finish()

	E2E.bootstrap("canary")
	if E2E.isActive()
		print("E2E canary armed")
