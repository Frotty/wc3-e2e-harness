package GroupBench
import E2E
import ClosureForGroups
import UnitIds
import ErrorHandling
import Execute

/*	Benchmarks iterating a unit group, in the real game on Lua: the stdlib's
	non-destructive `for u in g` (GroupIterator), its closure form, an index
	loop over BlzGroupUnitAt, and the destructive `for u from g` on a copy.
	Each iteration visits a group of GROUP_SIZE units LOOPS times.

	Blocks are bracketed by Preload marker files like the other bench suites
	(node/canary/read-bench-markers.cjs) and accumulate into locals. */

constant GROUP_SIZE = 16
constant LOOPS = 20000

group units = CreateGroup()
group scratch = CreateGroup()
unit array spawned
var checksum = 0
int closureSeen = 0

function marker(string name)
	PreloadGenClear()
	PreloadGenStart()
	Preload(name)
	PreloadGenEnd("wc3-e2e/canary/bench-" + name + ".txt")

function start(string block)
	marker(block + "-start")

function stop(string block)
	marker(block + "-end")

function iterForIn()
	var seen = 0
	start("group-for-in")
	for l = 1 to LOOPS
		for u in units
			if u != null
				seen++
	stop("group-for-in")
	checksum += seen

function iterIndex()
	var seen = 0
	start("group-index-loop")
	for l = 1 to LOOPS
		let n = BlzGroupGetSize(units)
		for i = 0 to n - 1
			if BlzGroupUnitAt(units, i) != null
				seen++
	stop("group-index-loop")
	checksum += seen

function iterForEachIn()
	closureSeen = 0
	start("group-foreach-in")
	for l = 1 to LOOPS
		units.forEachIn() u ->
			if u != null
				closureSeen++
	stop("group-foreach-in")
	checksum += closureSeen

function iterFromCopy()
	var seen = 0
	start("group-for-from-copy")
	for l = 1 to LOOPS
		GroupAddGroup(units, scratch)
		for u from scratch
			if u != null
				seen++
	stop("group-for-from-copy")
	checksum += seen

function guarded(string block, ForForceCallback body)
	let ok = try(body)
	E2E.assertTrue(block, ok)
	if not ok
		print("bench block " + block + " crashed: " + lastError)

public function runGroupBench()
	start("empty")
	stop("empty")
	for i = 0 to GROUP_SIZE - 1
		spawned[i] = CreateUnit(players[0], UnitIds.footman, -1500. + i * 32., -1500., 0.)
		GroupAddUnit(units, spawned[i])
	guarded("group-for-in", () -> iterForIn())
	guarded("group-index-loop", () -> iterIndex())
	guarded("group-foreach-in", () -> iterForEachIn())
	guarded("group-for-from-copy", () -> iterFromCopy())
	for i = 0 to GROUP_SIZE - 1
		RemoveUnit(spawned[i])
	E2E.recordMetric("checksum", checksum.toReal())
	E2E.assertTrue("bench-ran", checksum == 4 * LOOPS * GROUP_SIZE)
