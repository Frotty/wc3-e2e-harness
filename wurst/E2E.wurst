package E2E
import FileIO
import E2EProtocol
import ClosureTimers
import LinkedList

/*  Shared WC3 E2E harness — generic map-side runtime.

	The Node runner writes a one-shot ARMED launch file (frame-wrapped
	key=value body) into CustomMapData/wc3-e2e/<projectId>/ before Warcraft
	III spawns. E2E.bootstrap() reads it during the adapter's earliest init,
	arms E2E mode, emits READY, and starts the registered suite on the first
	game-time tick. Results and heartbeats go back through alternating output
	files as frame-wrapped, transposed JSON envelopes. There is no mid-game
	harness-to-map channel.

	Adapter usage:
		E2E.register("za-1") ->
			runFarHoleScenario()
		E2E.bootstrap("zombie-defense")
		if not E2E.isActive()
			// normal map startup
*/

/** Bumped on every protocol change; echoed in READY and verified by the runner. */
public constant E2E_PROTOCOL_VERSION = 2

constant HEARTBEAT_INTERVAL = 2.0
constant MAX_FAILED_IDS = 8
// A failing suite has to be able to report WHY it failed. At 16, a suite running several scenarios (or
// recording a reasoning trace) silently lost everything after the first one: the result looked complete
// while the diagnosis was missing. Truncation is counted too now, so it can never be invisible again.
constant MAX_EVENT_KINDS = 128
constant MAX_METRICS = 128

public interface E2ESuiteBody
	function run()

class Registration
	string suiteId
	E2ESuiteBody body

	construct(string suiteId, E2ESuiteBody body)
		this.suiteId = suiteId
		this.body = body

class EventCounter
	string id
	var count = 1

	construct(string id)
		this.id = id

/** A named measurement. Distinct from an event counter: an event asks "did this happen, how often", a
    metric asks "what was the value". Encoding a value into an event NAME instead ("hp-lost-1350") mints a
    brand-new event kind for every distinct value, which burns the kind budget and makes runs
    incomparable — the name itself changes when the number does. */
class Metric
	string id
	real value

	construct(string id, real value)
		this.id = id
		this.value = value

public class E2E
	private static constant registrations = new LinkedList<Registration>()
	private static constant events = new LinkedList<EventCounter>()
	private static constant metrics = new LinkedList<Metric>()
	private static var active = false
	private static var finished = false
	private static var finishRequested = false
	private static var heartbeatsStopped = false
	private static string projectId = ""
	private static string buildId = ""
	private static string runId = ""
	private static string nonce = ""
	private static string suiteId = ""
	private static var seq = 0
	private static var heartbeatCount = 0
	private static var gameSeconds = 0.
	private static var eventKindsDropped = 0
	private static var metricsDropped = 0
	private static var assertsPassed = 0
	private static var assertsFailed = 0
	private static var failedIds = ""
	private static var failedIdCount = 0
	private static var useFileA = true

	static function register(string suiteId, E2ESuiteBody body)
		registrations.add(new Registration(suiteId, body))

	static function isActive() returns boolean
		return active

	/** Call from the adapter's earliest init hook, after registrations. */
	static function bootstrap(string expectedProjectId)
		// Keep the optional Lua bridge exports reachable even when a consumer
		// invokes them dynamically from a map-side Lua chunk. They are no-ops
		// before a valid launch has armed this runtime.
		luaBridgeKeepAlive()
		let launch = new File("wc3-e2e/" + expectedProjectId + "/armed.pld")
			.readAsString(GetLocalPlayer())
		let frame = decodeFrame(launch)
		if not frame.ok
			return // no (valid) launch file: normal map start
		let body = frame.body
		if keyValue(body, "v") != I2S(E2E_PROTOCOL_VERSION)
			return
		if keyValue(body, "projectId") != expectedProjectId
			return
		projectId = expectedProjectId
		buildId = keyValue(body, "buildId")
		runId = keyValue(body, "runId")
		nonce = keyValue(body, "nonce")
		suiteId = keyValue(body, "suiteId")
		if runId == "" or nonce == "" or suiteId == ""
			return
		active = true
		// Do not write the first protocol snapshot from init itself. Warcraft can
		// execute map init while the loading screen is still being constructed;
		// defer the write to the next timer callback so the file is durable and
		// visible to the external watcher. The runner also sends Space while it
		// is waiting for READY, because this callback may not run until the map
		// leaves the loading screen.
		doAfter(0.) ->
			emit("READY", "{" + q("canReadFiles") + ":" + boolStr(CAN_READ_FILES) + "}")
			// Game-time does not advance until the map has left the loading screen
			// and the post-load pause has been cleared. Give map initialization a
			// short settle window, then publish a durable load notification before
			// starting the suite.
			doAfter(1.) ->
				emit("LOADED", "{" + q("mapLoaded") + ":true}")
				startSuite()

	static function assertTrue(string id, boolean condition)
		if not active or finished
			return
		if condition
			assertsPassed++
		else
			assertsFailed++
			if failedIdCount < MAX_FAILED_IDS
				failedIds += (failedIdCount > 0 ? "," : "") + id
				failedIdCount++

	/** Generic Lua-facing wrappers for map-side suites. */
	static function luaAssertTrue(string id, boolean condition)
		assertTrue(id, condition)

	static function luaRecordEvent(string id)
		recordEvent(id)

	static function luaRecordMetric(string id, real value)
		recordMetric(id, value)

	static function luaPulse()
		pulse()

	static function luaFinish()
		if not active or finished
			return
		// Lua calls this from a long-running timer callback. Only request the
		// terminal result here; the Wurst heartbeat callback below performs the
		// file write after the Lua callback has returned.
		finishRequested = true

	private static function luaBridgeKeepAlive()
		luaAssertTrue("", true)
		luaRecordEvent("")
		luaRecordMetric("", 0.)
		luaPulse()
		luaFinish()

	/** Publishes progress for a deliberately synchronous suite body. */
	static function pulse()
		if not active or finished
			return
		heartbeatCount++
		emit("RUNNING", "{}")

	// "event" itself collides with the JASS native type name.
	static function recordEvent(string id)
		if not active or finished
			return
		for counter in events
			if counter.id == id
				counter.count++
				return
		if events.size() < MAX_EVENT_KINDS
			events.add(new EventCounter(id))
		else
			// Never drop silently: a truncated event set previously looked identical to a complete one.
			eventKindsDropped++

	/** Records a named measurement, last write wins.

		Use this instead of baking a number into an event id. A metric keeps one stable name across runs, so
		results can be compared run to run, and it costs one slot no matter how much the value moves. */
	static function recordMetric(string id, real value)
		if not active or finished
			return
		for metric in metrics
			if metric.id == id
				metric.value = value
				return
		if metrics.size() < MAX_METRICS
			metrics.add(new Metric(id, value))
		else
			metricsDropped++

	static function recordMetric(string id, int value)
		recordMetric(id, value.toReal())

	static function finish()
		if not active or finished
			return
		finished = true
		let verdict = assertsFailed == 0 ? "PASS" : "FAIL"
		emit(verdict, resultPayload())

	/** Canary/testing hook: silences heartbeats without finishing. */
	static function stopHeartbeats()
		heartbeatsStopped = true

	private static function startSuite()
		Registration match = null
		for registration in registrations
			if registration.suiteId == suiteId
				match = registration
		if match == null
			finished = true
			emit("FAIL", "{" + q("error") + ":" + q("unknown-suite") + "}")
			return
		emit("RUNNING", "{}")
		doPeriodically(HEARTBEAT_INTERVAL) cb ->
			if finished
				destroy cb
			else if finishRequested
				finish()
				destroy cb
			else
				gameSeconds += HEARTBEAT_INTERVAL
				if not heartbeatsStopped
					heartbeatCount++
					emit("RUNNING", "{}")
		match.body.run()

	private static function resultPayload() returns string
		var eventsJson = "{"
		var first = true
		for counter in events
			eventsJson += (first ? "" : ",") + q(counter.id) + ":" + I2S(counter.count)
			first = false
		eventsJson += "}"
		var metricsJson = "{"
		var firstMetric = true
		for metric in metrics
			metricsJson += (firstMetric ? "" : ",") + q(metric.id) + ":" + R2S(metric.value)
			firstMetric = false
		metricsJson += "}"
		return "{" + q("asserts") + ":" + I2S(assertsPassed + assertsFailed)
			+ "," + q("failed") + ":" + I2S(assertsFailed)
			+ "," + q("failedIds") + ":" + q(failedIds)
			+ "," + q("eventKindsDropped") + ":" + I2S(eventKindsDropped)
			+ "," + q("metricsDropped") + ":" + I2S(metricsDropped)
			+ "," + q("metrics") + ":" + metricsJson
			+ "," + q("events") + ":" + eventsJson + "}"

	private static function emit(string state, string payloadJson)
		seq++
		let json = "{" + q("v") + ":" + I2S(E2E_PROTOCOL_VERSION)
			+ "," + q("projectId") + ":" + q(projectId)
			+ "," + q("buildId") + ":" + q(buildId)
			+ "," + q("runId") + ":" + q(runId)
			+ "," + q("nonce") + ":" + q(nonce)
			+ "," + q("suiteId") + ":" + q(suiteId)
			+ "," + q("seq") + ":" + I2S(seq)
			+ "," + q("state") + ":" + q(state)
			+ "," + q("gameTime") + ":" + R2S(gameSeconds)
			+ "," + q("heartbeat") + ":" + I2S(heartbeatCount)
			+ "," + q("payload") + ":" + payloadJson + "}"
		let path = "wc3-e2e/" + projectId + "/output-" + (useFileA ? "a" : "b") + ".pld"
		useFileA = not useFileA
		new File(path)..write(GetLocalPlayer(), encodeFrame(transpose(json)))..close()

	private static function q(string value) returns string
		return "\"" + value + "\""

	private static function boolStr(boolean value) returns string
		return value ? "true" : "false"
