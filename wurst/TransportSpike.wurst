package TransportSpike
import FileIO
import ClosureTimers

/* THROWAWAY — Phase 0 transport spike (docs/SharedE2EHarnessPlan.md).

   Verifies, on the current retail patch:
   1. A launch file written by Node (not the game) into a CustomMapData
      subdirectory reads back via stdlib readAsString() at map init.
   2. The map can write results into the same subdirectory.
   3. (When unpaused) heartbeat writes at a fixed game-time interval.

   Deleted at the end of Phase 0; must never ship to dependents. */

constant ARMED_PATH = "wc3-e2e/spike/armed.pld"
constant RESULT_PATH = "wc3-e2e/spike/spike-result.pld"
constant ROOT_RESULT_PATH = "spike-result-root.pld"
constant HEARTBEAT_PATH = "wc3-e2e/spike/heartbeat.pld"

var heartbeats = 0

init
    let localP = GetLocalPlayer()
    let armed = new File(ARMED_PATH).readAsString(localP)
    let canRead = CAN_READ_FILES ? "1" : "0"
    let summary = "spike1|canRead|" + canRead + "|len|" + I2S(armed.length()) + "|echo|" + armed
    new File(RESULT_PATH)..write(localP, summary)..close()
    new File(ROOT_RESULT_PATH)..write(localP, "root|canRead|" + canRead + "|len|" + I2S(armed.length()))..close()
    print("E2E spike: canRead=" + canRead + " armedLen=" + I2S(armed.length()))
    doPeriodically(2.) _cb ->
        heartbeats++
        new File(HEARTBEAT_PATH)..write(GetLocalPlayer(), "hb|" + I2S(heartbeats))..close()
